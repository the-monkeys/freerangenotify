    "request": {
      "user_id": "${USER_ID}",
      "notification_ids": [
        "${NOTIFICATION_ID}"
      ]
    }
  },
  {
    "id": "archive-notifications",
    "method": "PATCH",
    "path": "/notifications/bulk/archive",
