  {
    "id": "custom-webhook-poll",
    "method": "POST",
    "path": "/notifications",
    "guide": "webhooks",
    "auth": "api-key",
    "request": {
      "channel": "webhook",
      "title": "Choose a time",
      "body": "Team planning",
      "webhook_target": "registered-slack",
      "poll": {
        "question": "When?",
        "choices": [
          {
            "label": "Morning"
          },
          {
            "label": "Afternoon"
          }
        ],
        "duration_hours": 24
      }
    },
    "status": 202,
    "response": {
      "status": "queued",
      "content": {
        "poll": {
          "question": "When?"
        }
      }
    }
  },
  {
    "id": "otp-email",
    "method": "POST",
    "path": "/otp/send",
    "guide": "otp",
    "auth": "api-key",
    "request": {
      "channel": "email",
      "recipient": "alice@example.test",
      "ttl_seconds": 300
    },
    "status": 202,
    "response": {
      "request_id": "${OTP_REQUEST_ID}",
      "notification_id": "${OTP_NOTIFICATION_ID}",
      "channel": "email",
      "max_attempts": 5
    },
    "capture": {
      "OTP_REQUEST_ID": "request_id",
      "OTP_NOTIFICATION_ID": "notification_id"
    }
  },
  {
    "id": "otp-invalid-code",
    "method": "POST",
    "path": "/otp/verify",
    "guide": "otp",
    "auth": "api-key",
    "request": {
      "request_id": "${OTP_REQUEST_ID}",
      "code": "WRONG_CODE"
    },
    "status": 400,
    "response": {
      "verified": false,
      "request_id": "${OTP_REQUEST_ID}",
      "error": "invalid_code",
      "attempts_remaining": 4
    }
  },
  {
    "id": "otp-cooldown",
    "method": "POST",
    "path": "/otp/resend",
    "guide": "otp",
    "auth": "api-key",
    "request": {
      "request_id": "${OTP_REQUEST_ID}"
    },
    "status": 409,
    "response": {
      "error": "otp: resend cooldown in effect"
    }
  },
