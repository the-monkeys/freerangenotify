# Placeholder-only messaging configuration. Customer credentials belong in
# application/environment connections, not frontend builds or shared globals.
# Leave the switch UNSET to preserve independent legacy delivery/onboarding flags.
# FREERANGE_MESSAGING_META_ENABLED=false
# FREERANGE_MESSAGING_META_APP_ID=<public-platform-app-id>
# FREERANGE_MESSAGING_META_SIGNUP_CONFIG_ID=<public-embedded-signup-config-id>
# FREERANGE_MESSAGING_META_GRAPH_VERSION=v23.0
# FREERANGE_MESSAGING_META_APP_SECRET=<platform-signing-and-oauth-secret>
# FREERANGE_PROVIDERS_META_WHATSAPP_WEBHOOK_VERIFY=<verification-token>

# Optional platform Twilio account; explicit channel accounts take precedence.
# FREERANGE_MESSAGING_TWILIO_ACCOUNT_SID=<shared-account-sid>
# FREERANGE_MESSAGING_TWILIO_AUTH_TOKEN=<shared-auth-token>
# FREERANGE_PROVIDERS_TWILIO_FROM_NUMBER=<sms-sender>
# FREERANGE_PROVIDERS_WHATSAPP_FROM_NUMBER=<whatsapp-sender>
# Separate-account overrides must include both SID and token; no cross-account
# partial credential inheritance. All previous FREERANGE_PROVIDERS_* names work.
# FREERANGE_PROVIDERS_TWILIO_ACCOUNT_SID=<sms-account-sid>
# FREERANGE_PROVIDERS_TWILIO_AUTH_TOKEN=<sms-auth-token>
# FREERANGE_PROVIDERS_WHATSAPP_ACCOUNT_SID=<whatsapp-account-sid>
# FREERANGE_PROVIDERS_WHATSAPP_AUTH_TOKEN=<whatsapp-auth-token>

# Exotel remains off until account/DLT/rate evidence and budgets are verified.
FREERANGE_PROVIDERS_EXOTEL_ENABLED=false
FREERANGE_CONNECTION_WRITES_ENABLED=false
# FREERANGE_CONNECTION_ENCRYPTION_KEYS=<version:base64-32-byte-key>
FREERANGE_BILLING_ENFORCE_FREE_TIER_DAILY_CAP=true
# Daily cap is separate from sender/vendor throughput, spend and HTTP quotas.
# Legacy limits: free-tier SMS 3/day, WhatsApp 2/day. Disabling the cap does not
# bypass wallet checks or provider budgets. Queue retry policy remains in queue.*;
# provider max_retries keys remain readable but do not trigger blind send retries.
